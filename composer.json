{
  "name": "microunit/microunit",
  "description": "A new way to test PHP. Built for today. The dependency-free testing framework, with tests you can read at a glance and fast runs.",
  "type": "library",
  "license": "Apache-2.0",
  "keywords": ["testing", "unit-testing", "tdd", "mocking", "code-coverage", "test-runner"],
  "homepage": "https://mitarnik04.github.io/MicroUnit/",
  "authors": [
    {
      "name": "Mitar Nikolic",
      "email": "mitar.mn5@gmail.com",
      "homepage": "https://mitarnikolic.hstn.me",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.5"
  },
  "suggest": {
    "ext-tokenizer": "Required for code coverage (enabled in standard PHP builds)"
  },
  "autoload": {
    "psr-4": {
      "MicroUnit\\": "src/"
    }
  },
  "bin": [
    "bin/microunit"
  ],
  "scripts": {
    "test": "@php bin/microunit",
    "lint": "@php bin/lint.php"
  }
}
